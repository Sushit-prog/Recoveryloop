# Copy this file to `.env` (repo root) and fill in your Razorpay TEST-mode
# credentials. `.env` is gitignored and must never be committed.
# Real variables set in your shell still take precedence over this file.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here
LIVE_DEMO_EMAIL=you@example.com